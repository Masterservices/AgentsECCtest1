 "grammaire": [
  {
   "titre": "Le prépositionnel singulier (Lieu)",
   "explication": "Le prépositionnel est le cas utilisé pour indiquer le lieu où l'on se trouve (répondre à la question \"Где?\"). Au singulier, la grande majorité des noms masculins, féminins et neutres prennent la terminaison -е (стол → в столе, книга → в книге, окно → в окне). Cependant, pour les noms féminins se terminant par -ь ou les noms dont le radical se termine par les chuintantes (ж, ш, ч, щ) ou par ц, la terminaison est -и (площадь → на площади). C'est un cas qui s'emploie toujours avec une préposition, jamais seul.",
   "tableau": [
    [
     "Genre / Terminaison",
     "Nominatif",
     "Prépositionnel (в/на)"
    ],
    [
     "Masculin (consonne)",
     "стол, парк",
     "в столе́, в па́рке"
    ],
    [
     "Féminin (-а / -я)",
     "кни́га, аудито́рия",
     "в кни́ге, в аудито́рии"
    ],
    [
     "Neutre (-о / -е)",
     "окно́, музе́й",
     "в окне́, в музе́е"
    ],
    [
     "Féminin (-ь) / Chuintantes",
     "пло́щадь",
     "на пло́щади"
    ]
   ],
   "exemples": [
    {
     "cible": "Я в библиоте́ке.",
     "natif": "Je suis à la bibliothèque."
    },
    {
     "cible": "Мы на пло́щади.",
     "natif": "Nous sommes sur la place."
    }
   ]
  },
  {
   "titre": "Les prépositions в et на",
   "explication": "Pour dire \"à\" ou \"dans\" en russe, on utilise principalement в et на suivies du prépositionnel. В s'utilise pour un espace clos, un bâtiment ou un contenant (в библиотеке, в корпусе, в саду). На s'utilise pour une surface, un espace ouvert, un événement ou certaines institutions conceptuelles (на улице, на площади, на факультете). Contrairement au français où l'on dit \"à la fac\" ou \"dans la rue\", le russe distingue strictement l'intérieur/contenant (в) de la surface/extérieur (на). Notez que le choix dépend souvent de l'usage et doit être mémorisé avec le nom.",
   "tableau": [
    [
     "Préposition",
     "Usage principal",
     "Exemples"
    ],
    [
     "в",
     "Intérieur, bâtiment, contenant",
     "в университе́те, в ко́рпусе, в па́рке"
    ],
    [
     "на",
     "Surface, espace ouvert, événement",
     "на у́лице, на пло́щади, на факульте́те"
    ]
   ],
   "exemples": [
    {
     "cible": "Дима́ в обща́ге.",
     "natif": "Dima est à la résidence universitaire."
    },
    {
     "cible": "То́ма на факульте́те.",
     "natif": "Thomas est à la faculté."
    }
   ]
  }
 ],
 "prononciation": {
  "point": "Réduction vocalique : о et е non accentués",
  "explication": "En russe, seules les voyelles accentuées sont prononcées pleinement. Les voyelles non accentuées subissent une réduction. Le « о » non accentué se prononce comme un [a] bref (ou [ə] selon la position). Le « е » non accentué se prononce comme un [и]. Contrairement au français où l'on articule presque toutes les syllabes, le russe 'avale' les sons non accentués, ce qui donne son rythme caractéristique à la langue.",
  "exemples": [
   "Москва́ [м а ск в а] (maSKVA)",
   "хорошо́ [х а р а ш о] (khaRAsho)",
   "университе́т [у н и в э р с и т е т] (univerSIteT)"
  ]
 },
 "culture": {
  "titre": "Le campus russe : общага et столовая",
  "texte": "Le campus universitaire russe est un véritable microcosme. La résidence universitaire, familièrement appelée « обща́га » (obSHCHaga), est le cœur de la vie étudiante : on y partage des chambres, on y cuisine et on y crée des liens forts. La « столо́вая » (cantine) n'est pas seulement un lieu pour manger, c'est un espace social où les étudiants se retrouvent entre les cours pour discuter et échanger des nouvelles. Quant à la bibliothèque, elle reste un lieu d'étude sérieux, mais aussi un point de rencontre incontournable, surtout en période d'examens. Ces espaces forgent l'identité et la solidarité étudiantes en Russie."
 },
